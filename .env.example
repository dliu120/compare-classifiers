# Copy to .env and fill in. .env is gitignored; never commit real keys.
# TypeSafe Jev  — https://console.typesafe.ai/keys  (use-jev already stores one under ~/.config/agent-skills/use-jev/api-key)
TYPESAFE_API_KEY=
# OpenAI Decisions API (public beta, gpt-6-luna) — https://platform.openai.com
OPENAI_API_KEY=
# Cloudflare Workers AI Clef / Clef-flash — API token with Workers AI permission + account id
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
# Liquid AI d1 — https://console.liquid.ai (Dashboard > API Keys)
LIQUID_API_KEY=
FOUNDRY_ENDPOINT=
FOUNDRY_ACCESS_TOKEN=
FOUNDRY_DEPLOYMENT_NAME=decision-1
FOUNDRY_REQUESTS_PER_MINUTE=30
# Own build: local aiproxy over GitHub Copilot (no key; auth mode "none")
AIPROXY_BASE_URL=http://127.0.0.1:17688/v1
